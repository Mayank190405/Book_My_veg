{"openapi":"3.0.3","info":{"title":"Omni-Chat Public API","description":"Public API documentation for Omni-Chat. These endpoints can be accessed using your API Key.\n\n## Authentication\nAll endpoints require API Key authentication. You can generate your API Key from your dashboard under API Settings.\n\n### API Key Usage\nInclude your API key in one of the following headers:\n- `x-api-key: YOUR_API_KEY` (Recommended)\n- `api-key: YOUR_API_KEY`\n- `authorization: ApiKey YOUR_API_KEY`\n\n### Rate Limits\n- API requests are rate-limited per API key\n- Maximum 5 failed authentication attempts per minute\n","version":"1.0.0","contact":{"name":"Omni-Chat Support","email":"support@omnichat.com"}},"servers":[{"url":"/v1","description":"Current frontend origin (recommended). Uses localhost in dev and production domain in prod."},{"url":"https://chatbot.digitalmbg.com/v1","description":"Production frontend domain"},{"url":"http://localhost:3000/v1","description":"Local frontend dev server (explicit)"},{"url":"http://localhost:4500/api","description":"Direct backend access (skips the /v1 proxy)"}],"components":{"securitySchemes":{"ApiKeyAuth":{"type":"apiKey","in":"header","name":"x-api-key","description":"Your API key from Dashboard → API Settings. \"Try it out\" sends this as `x-api-key`.\nThe same key also works in headers `api-key: …` or `Authorization: ApiKey …` (optional; use any one).\n"}},"schemas":{"WhatsAppSendText":{"type":"object","required":["text","senderId"],"properties":{"text":{"type":"string","description":"Message text","example":"Hello, this is a test message"},"senderId":{"type":"string","description":"WhatsApp number with country code (required)","example":"917879431560"},"chatId":{"type":"string","description":"Chat ID (optional, if provided will be used instead of finding by senderId)","example":"chat_123456"}}},"WhatsAppSendImage":{"type":"object","required":["url","senderId"],"properties":{"url":{"type":"string","description":"Image URL or base64","example":"https://example.com/image.jpg"},"senderId":{"type":"string","description":"WhatsApp number with country code (required)","example":"917879431560"},"chatId":{"type":"string","description":"Chat ID (optional, if provided will be used instead of finding by senderId)","example":"chat_123456"},"caption":{"type":"string","description":"Optional image caption","example":"Check out this image"}}},"WhatsAppSendVideo":{"type":"object","required":["url","senderId"],"properties":{"url":{"type":"string","description":"Video URL or base64","example":"https://example.com/video.mp4"},"senderId":{"type":"string","description":"WhatsApp number with country code (required)","example":"917879431560"},"chatId":{"type":"string","description":"Chat ID (optional, if provided will be used instead of finding by senderId)","example":"chat_123456"},"caption":{"type":"string","description":"Optional video caption","example":"Check out this video"}}},"WhatsAppSendDocument":{"type":"object","required":["url","senderId"],"properties":{"url":{"type":"string","description":"Document URL or base64","example":"https://example.com/document.pdf"},"senderId":{"type":"string","description":"WhatsApp number with country code (required)","example":"917879431560"},"chatId":{"type":"string","description":"Chat ID (optional, if provided will be used instead of finding by senderId)","example":"chat_123456"},"caption":{"type":"string","description":"Optional document caption","example":"Please review this document"}}},"WhatsAppSendAudio":{"type":"object","required":["url","senderId"],"properties":{"url":{"type":"string","description":"Audio URL or base64","example":"https://example.com/audio.mp3"},"senderId":{"type":"string","description":"WhatsApp number with country code (required)","example":"917879431560"},"chatId":{"type":"string","description":"Chat ID (optional, if provided will be used instead of finding by senderId)","example":"chat_123456"}}},"WhatsAppSendTemplate":{"type":"object","required":["templateName","senderId"],"properties":{"templateName":{"type":"string","description":"Template name","example":"welcome_message"},"senderId":{"type":"string","description":"WhatsApp number with country code (required)","example":"917879431560"},"chatId":{"type":"string","description":"Chat ID (optional, if provided will be used instead of finding by senderId)","example":"chat_123456"},"variables":{"type":"object","description":"Template variables/parameters organized by component.\n**Required if the template has variable placeholders** (e.g., {{1}}, {{2}}).\n- `header`: Array of variables for HEADER component (if template has TEXT header with variables)\n- `body`: Array of variables for BODY component (if template has body variables)\nIf template has no variables, this field can be omitted or left empty.\n","properties":{"header":{"type":"array","items":{"type":"string"},"description":"Variables for template header component (if header format is TEXT)","example":["Header Variable 1"]},"body":{"type":"array","items":{"type":"string"},"description":"Variables for template body component","example":["John","Doe"]}},"example":{"header":[],"body":["John","Doe"]}},"dynamicMedia":{"type":"string","description":"Dynamic media URL for template (image, video, or document).\n**Required if the template has a media component** that needs to be dynamically set.\nProvide the full URL to the media file (image, video, or document).\nIf template has no media or uses static media, this field can be omitted.\n","nullable":true,"example":"https://pub-f6fd8df047dc4f05b4bbe7e8b1642004.r2.dev/media/XBZNKxjaWiaDLlcL3wqm61iG2t381VtV.mp4"}}},"AddContactRequest":{"type":"object","required":["mobile","name"],"properties":{"id":{"type":"integer","description":"Phonebook ID (optional, for updates)","example":60},"mobile":{"type":"string","description":"Phone number with country code","example":"+923300000000"},"name":{"type":"string","description":"Contact name","example":"John Doe"},"source":{"type":"string","description":"Contact source (optional, default: \"manual\")","example":"manual"}}},"SetCustomFieldsRequest":{"type":"object","required":["sender_id","custom_fields"],"properties":{"sender_id":{"type":"string","description":"Contact phone number (sender_id)","example":"+923300000000"},"custom_fields":{"type":"object","description":"Custom field values (key-value pairs)","example":{"var1":"Value 1","var2":"Value 2","company":"ABC Corp"}},"action":{"type":"string","enum":["update","add","delete"],"description":"Action to perform (default: \"update\")","example":"update"}}},"UpsertCustomField":{"type":"object","required":["key","label","type"],"properties":{"key":{"type":"string","description":"Unique field key/identifier","example":"company"},"label":{"type":"string","description":"Field display label","example":"Company"},"type":{"type":"string","enum":["text","number","date","email","phone","select","checkbox"],"description":"Field type","example":"text"},"required":{"type":"boolean","description":"Whether field is required","example":false},"default_val":{"type":"string","description":"Default field value (optional)","example":""},"options_json":{"type":"object","description":"Options for select/checkbox fields (optional)","example":{"options":["Option 1","Option 2"]}},"validate":{"type":"object","description":"Validation rules (optional)","example":{"min":0,"max":100}},"position":{"type":"integer","description":"Field position/order (optional)","example":0}}},"ContactsSendFlowRequest":{"type":"object","required":["senderId","actions"],"properties":{"senderId":{"type":"string","description":"Customer's WhatsApp number with country code","example":"+919900000000"},"name":{"type":"string","description":"Contact name — resolves {{__contact_name}} in flow nodes","example":"John Smith"},"actions":{"type":"array","description":"Actions to run in order. Must contain exactly one send_flow action.","items":{"oneOf":[{"type":"object","description":"Set a custom field value on the contact before the flow fires","required":["action","field_name","value"],"properties":{"action":{"type":"string","enum":["set_field_value"]},"field_name":{"type":"string","example":"city"},"value":{"type":"string","example":"Mumbai"}}},{"type":"object","description":"Trigger a flow","required":["action","flow_id"],"properties":{"action":{"type":"string","enum":["send_flow"]},"flow_id":{"type":"string","description":"Flow builder id (column `flows.flow_id`) — same string as in the dashboard URL `/devflow/{flow_id}`.\nLegacy: an all-numeric value is still accepted as the database primary key `flows.id`.\n","example":"flow_1730000000000_abc12"}}}]}}}},"SuccessResponse":{"type":"object","properties":{"success":{"type":"boolean","example":true},"message":{"type":"string","example":"Operation successful"},"data":{"type":"object"}}},"ErrorResponse":{"type":"object","properties":{"success":{"type":"boolean","example":false},"message":{"type":"string","example":"Error message"},"error":{"type":"string","example":"Error details"}}}}},"security":[{"ApiKeyAuth":[]}],"paths":{"/whatsapp/send_text":{"post":{"summary":"Send text message","description":"Send a text message via WhatsApp.\n`senderId` is required. `chatId` is optional - if provided, it will be used directly; otherwise chat will be found using senderId.\n","tags":["WhatsApp Messages"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WhatsAppSendText"},"examples":{"example1":{"value":{"text":"Hello, this is a test message","senderId":"917879431560"}},"example2":{"value":{"text":"Hello, this is a test message","senderId":"917879431560","chatId":"chat_123456"}}}}}},"responses":{"200":{"description":"Message sent successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"400":{"description":"Bad request"},"401":{"description":"Unauthorized - Invalid API key"}}}},"/whatsapp/send_image":{"post":{"summary":"Send image message","description":"Send an image via WhatsApp.\n`senderId` is required. `chatId` is optional - if provided, it will be used directly; otherwise chat will be found using senderId.\n","tags":["WhatsApp Messages"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WhatsAppSendImage"},"examples":{"example1":{"value":{"url":"https://example.com/image.jpg","senderId":"917879431560","caption":"Check out this image"}},"example2":{"value":{"url":"https://example.com/image.jpg","senderId":"917879431560","chatId":"chat_123456","caption":"Check out this image"}}}}}},"responses":{"200":{"description":"Image sent successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/whatsapp/send_video":{"post":{"summary":"Send video message","description":"Send a video via WhatsApp.\n`senderId` is required. `chatId` is optional - if provided, it will be used directly; otherwise chat will be found using senderId.\n","tags":["WhatsApp Messages"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WhatsAppSendVideo"},"examples":{"example1":{"value":{"url":"https://example.com/video.mp4","senderId":"917879431560","caption":"Check out this video"}},"example2":{"value":{"url":"https://example.com/video.mp4","senderId":"917879431560","chatId":"chat_123456","caption":"Check out this video"}}}}}},"responses":{"200":{"description":"Video sent successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/whatsapp/send_doc":{"post":{"summary":"Send document","description":"Send a document via WhatsApp.\n`senderId` is required. `chatId` is optional - if provided, it will be used directly; otherwise chat will be found using senderId.\n","tags":["WhatsApp Messages"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WhatsAppSendDocument"},"examples":{"example1":{"value":{"url":"https://example.com/document.pdf","senderId":"917879431560","caption":"Please review this document"}},"example2":{"value":{"url":"https://example.com/document.pdf","senderId":"917879431560","chatId":"chat_123456","caption":"Please review this document"}}}}}},"responses":{"200":{"description":"Document sent successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/whatsapp/send_audio":{"post":{"summary":"Send audio message","description":"Send an audio file via WhatsApp.\n`senderId` is required. `chatId` is optional - if provided, it will be used directly; otherwise chat will be found using senderId.\n","tags":["WhatsApp Messages"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WhatsAppSendAudio"},"examples":{"example1":{"value":{"url":"https://example.com/audio.mp3","senderId":"917879431560"}},"example2":{"value":{"url":"https://example.com/audio.mp3","senderId":"917879431560","chatId":"chat_123456"}}}}}},"responses":{"200":{"description":"Audio sent successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/whatsapp/send_templet":{"post":{"summary":"Send template message","description":"Send a WhatsApp template message.\n\n**Required Fields:**\n- `templateName`: Name of the template\n- `senderId`: WhatsApp number with country code\n\n**Conditionally Required:**\n- `variables`: **Required if the template has variable placeholders** (e.g., {{1}}, {{2}})\n- `dynamicMedia`: **Required if the template has a media component** that needs to be dynamically set\n\n**Optional:**\n- `chatId`: If provided, will be used directly; otherwise chat will be found using senderId\n\n**Note:** Check your template structure before sending. If template requires variables or dynamic media, those fields must be provided.\n","tags":["WhatsApp Messages"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WhatsAppSendTemplate"},"examples":{"example1":{"summary":"Template with body variables only","description":"Template that has body variable placeholders but no header variables or media","value":{"templateName":"welcome_message","senderId":"917879431560","variables":{"header":[],"body":["John","Doe"]}}},"example2":{"summary":"Template with header and body variables","description":"Template that has both header and body variables","value":{"templateName":"notification_template","senderId":"917879431560","variables":{"header":["Important"],"body":["John","Your order is ready"]}}},"example3":{"summary":"Template with variables and dynamic media","description":"Template that has both variables and dynamic media component","value":{"templateName":"final_video_template_","chatId":"jjDBDjIujUSijjSIuIjuuiSi","senderId":"917879431560","variables":{"header":[],"body":["User"]},"dynamicMedia":"https://pub-f6fd8df047dc4f05b4bbe7e8b1642004.r2.dev/media/XBZNKxjaWiaDLlcL3wqm61iG2t381VtV.mp4"}},"example4":{"summary":"Template with dynamic media only","description":"Template that has dynamic media but no variables","value":{"templateName":"image_template","senderId":"917879431560","dynamicMedia":"https://example.com/image.jpg"}},"example5":{"summary":"Simple template without variables or media","description":"Template that has no variables and no dynamic media","value":{"templateName":"simple_notification","senderId":"917879431560"}}}}}},"responses":{"200":{"description":"Template sent successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/whatsapp/get_my_meta_templets":{"get":{"summary":"Get WhatsApp templates","description":"Retrieve list of approved WhatsApp templates","tags":["WhatsApp Templates"],"responses":{"200":{"description":"Templates retrieved successfully","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"status":{"type":"string"}}}}}}}}},"401":{"description":"Unauthorized"}}}},"/phonebook/add_single_contact":{"post":{"summary":"Add or update contact","description":"Add a new contact or update existing contact in phonebook","tags":["Phonebook"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddContactRequest"},"examples":{"example1":{"value":{"mobile":"+923300000000","name":"John Doe","id":60,"source":"manual"}}}}}},"responses":{"200":{"description":"Contact added/updated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessResponse"}}}},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/phonebook/set_custom_fields":{"post":{"summary":"Set custom fields for contact","description":"Update, add, or delete custom field values for a contact.\nUse `action` parameter: \"update\" (default), \"add\", or \"delete\"\n","tags":["Phonebook"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetCustomFieldsRequest"},"examples":{"example1":{"value":{"sender_id":"+923300000000","custom_fields":{"var1":"Value 1","company":"ABC Corp"},"action":"update"}}}}}},"responses":{"200":{"description":"Custom fields updated successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/phonebook/get_list":{"get":{"summary":"List tags (phonebooks)","description":"Returns all tags (phonebooks) for the authenticated user — id and name only. Accepts both API key and JWT.","tags":["Phonebook"],"responses":{"200":{"description":"Tag list retrieved successfully","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean","example":true},"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","example":"92"},"name":{"type":"string","example":"Mohit"}}}}}}}}},"401":{"description":"Unauthorized"}}}},"/phonebook/remove_tag":{"post":{"summary":"Remove tag from contact","description":"Removes a tag (phonebook) from a contact identified by mobile number. Accepts both API key and JWT.","tags":["Phonebook"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["mobile","phonebook_id"],"properties":{"mobile":{"type":"string","example":"+919976474297"},"phonebook_id":{"type":"string","example":"92"}}},"examples":{"example1":{"value":{"mobile":"+919976474297","phonebook_id":"92"}}}}}},"responses":{"200":{"description":"Tag removed successfully","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean","example":true},"data":{"type":"object","properties":{"removed":{"type":"boolean","example":true}}}}}}}},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"},"404":{"description":"Contact not found"}}}},"/chat_flow/get_list":{"get":{"summary":"List flows","description":"Returns all flows for the authenticated user — id and name only. Accepts both API key and JWT.","tags":["Flows"],"responses":{"200":{"description":"List of flows","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean","example":true},"data":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","example":"flow_1730000000000_abc12"},"name":{"type":"string","example":"Welcome Flow"}}}}}}}}}}},"401":{"description":"Unauthorized — invalid or missing API key / JWT"}}}},"/contacts/send_flow":{"post":{"summary":"Send flow to a contact","description":"Creates or finds a contact, writes contact data to DB, then triggers a chatbot flow.\nTemplate placeholders (`{{__contact_name}}`, `{{city}}`, etc.) resolve correctly\nbecause `set_field_value` actions run before the flow fires.\n\n**actions[] rules:**\n- Must contain exactly one `send_flow` action\n- `set_field_value` actions run in order before the flow\n- `send_flow.flow_id` must be the **flow builder id** (`flows.flow_id`), e.g. from All Flows or the `/devflow/...` URL — not the numeric database `id` unless you use the legacy all-numeric form.\n","tags":["Contacts"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactsSendFlowRequest"},"examples":{"example1":{"summary":"New contact with custom fields","value":{"senderId":"+919900000000","name":"John Smith","actions":[{"action":"set_field_value","field_name":"city","value":"Mumbai"},{"action":"set_field_value","field_name":"order_id","value":"ORD-001"},{"action":"send_flow","flow_id":"flow_1730000000000_abc12"}]}},"example2":{"summary":"Trigger flow only (no custom fields)","value":{"senderId":"+919900000000","name":"John Smith","actions":[{"action":"send_flow","flow_id":"flow_1730000000000_abc12"}]}}}}}},"responses":{"200":{"description":"Flow triggered successfully","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean","example":true},"data":{"type":"object","properties":{"sent":{"type":"integer","example":1},"results":{"type":"array","items":{"type":"object"}}}}}}}}},"400":{"description":"Bad request — missing senderId, missing/invalid actions[]"},"401":{"description":"Unauthorized — invalid or missing API key"},"403":{"description":"Flow belongs to a different user"},"404":{"description":"Flow not found or no WhatsApp account linked"}}}},"/custom-fields/get_custom_fields":{"get":{"summary":"Get custom fields","description":"Retrieve all custom fields","tags":["Custom Fields"],"responses":{"200":{"description":"Custom fields retrieved successfully","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object"}}}}}}},"401":{"description":"Unauthorized"}}}},"/custom-fields/get_account_fields":{"get":{"summary":"Get account fields","description":"Retrieve account-level custom fields","tags":["Custom Fields"],"responses":{"200":{"description":"Account fields retrieved successfully"},"401":{"description":"Unauthorized"}}}},"/custom-fields/get_all_fields":{"get":{"summary":"Get all fields","description":"Retrieve all custom fields (account + contact)","tags":["Custom Fields"],"responses":{"200":{"description":"All fields retrieved successfully"},"401":{"description":"Unauthorized"}}}},"/custom-fields/upsert_custom_field":{"post":{"summary":"Create or update custom field","description":"Create a new custom field or update existing one","tags":["Custom Fields"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpsertCustomField"}}}},"responses":{"200":{"description":"Custom field created/updated successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}},"/custom-fields/upsert_account_field":{"post":{"summary":"Create or update account field","description":"Create or update account-level custom field","tags":["Custom Fields"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpsertCustomField"}}}},"responses":{"200":{"description":"Account field created/updated successfully"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"}}}}}}