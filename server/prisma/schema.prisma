generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  phone          String          @unique
  email          String?         @unique
  name           String?
  role           Role            @default(USER)
  password       String?
  isActive       Boolean         @default(true)
  lastLogin      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  locationId     String?
  joiningDate    DateTime?
  leavingDate    DateTime?
  baseSalary     Decimal?        @db.Decimal(10, 2)
  profileAddress String?
  totalDue       Decimal         @default(0) @db.Decimal(10, 2)
  addresses      Address[]
  attendance     Attendance[]    @relation("UserAttendance")
  auditLogs      AuditLog[]
  batches        Batch[]
  cart           Cart?
  shifts         CashierShift[]
  inventoryLogs  InventoryLog[]
  mortalityLogs  MortalityLog[]
  notifications  Notification[]
  deliveries     Order[]         @relation("OrderDeliveryPartner")
  packedOrders   Order[]         @relation("OrderPacker")
  staffOrders    Order[]         @relation("OrderStaff")
  orders         Order[]
  reviews        Review[]
  searchHistory  SearchHistory[]
  expenses       StoreExpense[]
  location       Location?       @relation(fields: [locationId], references: [id])
  targetedCoupons CouponUserTarget[]
  assignedIncidents SecurityIncident[] @relation("IncidentAssignee")
  incidentComments  IncidentComment[]
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  type        AddressType @default(HOME)
  fullAddress String
  landmark    String?
  city        String?
  state       String?
  pincode     String?
  name        String?
  phone       String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean     @default(false)
  tag         String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  icon      String?
  imageUrl  String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Unit {
  id        String   @id @default(uuid())
  name      String   @unique
  symbol    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                 String           @id @default(uuid())
  name               String
  slug               String           @unique
  description        String?
  categoryId         String
  images             String[]
  basePrice          Decimal?         @db.Decimal(10, 2)
  taxSlab            Decimal          @default(0) @db.Decimal(5, 2)
  weightUnit         WeightUnit       @default(KG)
  minQuantity        Int              @default(1)
  maxQuantity        Int              @default(10)
  isActive           Boolean          @default(true)
  countryOfOrigin    String?
  shelfLife          String?
  packagedDate       DateTime?
  fssaiLicense       String?
  nutritionInfo      Json?
  specifications     Json?
  tags               Json?
  version            Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  isWebsitePublished Boolean          @default(true)
  sku                String?          @unique
  barcode            String?          @unique
  gstRate            Decimal          @default(0) @db.Decimal(5, 2)
  hsnCode            String?
  isFavourite        Boolean          @default(false)
  batch              Batch[]
  cartItems          CartItem[]
  inventory          Inventory[]
  inventoryLogs      InventoryLog[]
  mortalityLogs      MortalityLog[]
  orderItems         OrderItem[]
  pricing            Pricing[]
  category           Category         @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  reviews            Review[]
  sectionProducts    SectionProduct[]

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([barcode])
  @@index([isFavourite])
}

model ProductVariant {
  id            String         @id @default(uuid())
  productId     String
  name          String
  price         Decimal        @db.Decimal(10, 2)
  weight        Decimal?       @db.Decimal(10, 2)
  weightUnit    WeightUnit     @default(GM)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  batches       Batch[]
  cartItems     CartItem[]
  inventory     Inventory[]
  inventoryLogs InventoryLog[]
  orderItems    OrderItem[]
  pricing       Pricing[]
  product       Product        @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([isActive])
}

model Location {
  id             String         @id @default(uuid())
  slug           String         @unique
  name           String
  password       String?
  address        String?
  contactNumber  String?
  gstNumber      String?
  receiptFooter  String?
  receiptHeader  String?
  latitude       Float?
  longitude      Float?
  deliveryRadius Float?         @default(10.0)
  isOpen         Boolean        @default(true)
  upiId          String?
  attendance     Attendance[]
  batches        Batch[]
  shifts         CashierShift[]
  inventory      Inventory[]
  inventoryLogs  InventoryLog[]
  mortalityLogs  MortalityLog[]
  orders         Order[]
  orderItems     OrderItem[]
  expenses       StoreExpense[]
  users          User[]
  apiKeys        ApiKey[]
}

model Inventory {
  id             String          @id @default(uuid())
  productId      String
  variantId      String?
  locationId     String
  currentStock   Decimal         @default(0) @db.Decimal(12, 3)
  thresholdStock Decimal         @default(5) @db.Decimal(12, 3)
  lastRestocked  DateTime?
  isLowStock     Boolean         @default(false)
  updatedAt      DateTime        @updatedAt
  location       Location        @relation(fields: [locationId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([productId, locationId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Pricing {
  id            String          @id @default(uuid())
  productId     String
  variantId     String?
  channel       Channel         @default(WEB)
  price         Decimal         @db.Decimal(10, 2)
  discountType  DiscountType?
  discountValue Decimal?        @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean         @default(true)
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([isActive, endDate])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Decimal         @default(1) @db.Decimal(12, 3)
  metadata  Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id                String               @id @default(uuid())
  userId            String
  totalAmount       Decimal              @db.Decimal(10, 2)
  status            OrderStatus          @default(PENDING)
  paymentStatus     String               @default("PENDING")
  shippingAddress   Json
  deliveryDate      DateTime?
  deliverySlot      String?
  couponId          String?
  discountAmount    Decimal              @default(0) @db.Decimal(10, 2)
  channel           Channel              @default(WEB)
  taxAmount         Decimal              @default(0) @db.Decimal(10, 2)
  deliveryCharge    Decimal              @default(0) @db.Decimal(10, 2)
  isPaid            Boolean              @default(false)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  isCredit          Boolean              @default(false)
  idempotencyKey    String?              @unique
  locationId        String?
  deliveryPartnerId String?
  packerId          String?
  packedAt          DateTime?
  packerNotes       String?
  packerPhoto       String?
  deliveryPhoto     String?
  deliveryOtp       String?
  staffId           String?
  coupon            Coupon?              @relation(fields: [couponId], references: [id])
  deliveryPartner   User?                @relation("OrderDeliveryPartner", fields: [deliveryPartnerId], references: [id])
  location          Location?            @relation(fields: [locationId], references: [id])
  packer            User?                @relation("OrderPacker", fields: [packerId], references: [id])
  staff             User?                @relation("OrderStaff", fields: [staffId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]

  @@index([userId])
  @@index([locationId])
  @@index([deliveryPartnerId])
  @@index([packerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  productId         String
  variantId         String?
  quantity          Decimal         @db.Decimal(12, 3)
  sellingPrice      Decimal         @db.Decimal(10, 2)
  costPriceSnapshot Decimal         @default(0) @db.Decimal(10, 2)
  marginSnapshot    Decimal         @default(0) @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  locationId        String?
  location          Location?       @relation(fields: [locationId], references: [id])
  order             Order           @relation(fields: [orderId], references: [id])
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([locationId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  remark    String?
  changedBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  amount        Decimal  @db.Decimal(10, 2)
  method        String
  transactionId String?
  status        String
  metadata      Json?
  createdAt     DateTime @default(now())
  changeGiven   Decimal? @db.Decimal(10, 2)
  denominations Json?
  order         Order    @relation(fields: [orderId], references: [id])
}

model SecurityAuditLog {
  id                 String   @id @default(uuid())
  tableName          String
  attemptedOperation String
  attemptedBy        String?
  timestamp          DateTime @default(now())
  rawQuerySnippet    String?
  severity           String   @default("CRITICAL")

  @@index([timestamp])
}

model Banner {
  id           String         @id @default(uuid())
  position     BannerPosition @default(HOME_TOP)
  imageUrl     String
  link         String?
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  title        String?
  subtitle     String?
  redirectType String?        @default("external")
  redirectId   String?
  buttonText   String?
  priority     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Section {
  id        String           @id @default(uuid())
  title     String
  type      String
  rules     Json?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  SectionProduct[]
}

model SectionProduct {
  id        String  @id @default(uuid())
  sectionId String
  productId String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  @@unique([sectionId, productId])
}

model OtpTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  updatedAt DateTime @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}

model Review {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  rating             Int      @default(5)
  comment            String?
  images             String[]
  isVerifiedPurchase Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id])
  user               User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
}

model SearchHistory {
  id             String   @id @default(uuid())
  userId         String
  query          String
  count          Int      @default(1)
  lastSearchedAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, query])
  @@index([userId])
  @@index([lastSearchedAt])
}

model Coupon {
  id                 String             @id @default(uuid())
  code               String             @unique
  type               CouponType         @default(DISCOUNT)
  description        String             @default("")
  
  // Reward parameters
  discountType       DiscountType?      @default(FLAT)
  discountValue      Decimal?           @db.Decimal(10, 2)
  maxDiscount        Decimal?           @db.Decimal(10, 2)
  rewardProductId    String?            // The free/₹1/discounted item (for gift/special price)
  rewardVariantId    String?
  specialPrice       Decimal?           @db.Decimal(10, 2)
  
  // Core constraints
  minOrderAmount     Decimal            @default(0) @db.Decimal(10, 2)
  expiresAt          DateTime?
  isActive           Boolean            @default(true)
  usageLimit         Int?               // Global usage limit
  userUsageLimit     Int                @default(1) // Max times a single user can redeem it
  usedCount          Int                @default(0)
  
  // Advanced Rule Specifications (JSON configuration objects)
  cartRulesJson      Json?            
  scheduleRulesJson  Json?            
  
  // Targeting Relations
  allowedLocations   String[]           // List of allowed store/warehouse locationIds
  allowedPincodes    String[]           // Geofenced offers
  allowedPayment     String[]           // e.g., ["UPI", "WALLET"]
  
  // Dedicated user associations
  userSegments       UserGroupSegment[] @default([ALL])
  targetedUsers      CouponUserTarget[] // Individual dedicated user links
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orders             Order[]

  @@index([isActive])
}

model InventoryLog {
  id         String           @id @default(uuid())
  productId  String
  variantId  String?
  batchId    String?
  locationId String
  type       InventoryLogType
  beforeQty  Decimal          @db.Decimal(12, 3)
  afterQty   Decimal          @db.Decimal(12, 3)
  delta      Decimal          @db.Decimal(12, 3)
  staffId    String?
  createdAt  DateTime         @default(now())
  batch      Batch?           @relation(fields: [batchId], references: [id])
  location   Location         @relation(fields: [locationId], references: [id])
  product    Product          @relation(fields: [productId], references: [id])
  staff      User?            @relation(fields: [staffId], references: [id])
  variant    ProductVariant?  @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
}

model Batch {
  id            String          @id @default(uuid())
  productId     String
  variantId     String?
  locationId    String
  batchNumber   String
  costPrice     Decimal         @db.Decimal(12, 2)
  initialQty    Decimal         @db.Decimal(12, 3)
  remainingQty  Decimal         @db.Decimal(12, 3)
  receivedDate  DateTime        @default(now())
  expiryDate    DateTime?
  version       Int             @default(0)
  staffId       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  location      Location        @relation(fields: [locationId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  staff         User?           @relation(fields: [staffId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  inventoryLogs InventoryLog[]
  mortalityLogs MortalityLog[]

  @@index([productId])
  @@index([locationId])
  @@index([expiryDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  staffId    String?
  locationId String?
  createdAt  DateTime @default(now())
  staff      User?    @relation(fields: [staffId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model InventoryLedger {
  id               String                       @id @default(uuid())
  storeId          String
  productId        String
  referenceType    InventoryLedgerReferenceType
  referenceId      String
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  createdAt        DateTime                     @default(now())
  createdBy        String

  @@index([storeId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Attendance {
  id         String    @id @default(uuid())
  userId     String?
  locationId String
  checkIn    DateTime  @default(now())
  checkOut   DateTime?
  status     String    @default("PRESENT")
  location   Location  @relation(fields: [locationId], references: [id])
  user       User?     @relation("UserAttendance", fields: [userId], references: [id])

  @@index([userId, checkIn])
  @@index([locationId])
}

model CashierShift {
  id                  String    @id @default(uuid())
  staffId             String?
  locationId          String
  startTime           DateTime  @default(now())
  endTime             DateTime?
  openingCash         Decimal   @db.Decimal(10, 2)
  closingCash         Decimal?  @db.Decimal(10, 2)
  expectedCash        Decimal?  @db.Decimal(10, 2)
  openingDenominations Json?
  closingDenominations Json?
  currentDenominations Json?
  notes               String?
  status              String    @default("OPEN")
  location            Location  @relation(fields: [locationId], references: [id])
  staff               User?     @relation(fields: [staffId], references: [id])

  @@index([staffId, status])
  @@index([locationId])
}

model StoreExpense {
  id            String   @id @default(uuid())
  locationId    String
  staffId       String?
  amount        Decimal  @db.Decimal(10, 2)
  category      String
  description   String?
  receiptUrl    String?
  denominations Json?
  createdAt     DateTime @default(now())
  location      Location @relation(fields: [locationId], references: [id])
  staff         User?    @relation(fields: [staffId], references: [id])

  @@index([locationId, createdAt])
}

model MortalityLog {
  id         String   @id @default(uuid())
  productId  String
  variantId  String?
  batchId    String?
  locationId String
  reason     String
  quantity   Decimal  @db.Decimal(12, 3)
  staffId    String?
  createdAt  DateTime @default(now())
  costPrice  Decimal  @db.Decimal(12, 2)
  totalLoss  Decimal  @db.Decimal(12, 2)
  batch      Batch?   @relation(fields: [batchId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  staff      User?    @relation(fields: [staffId], references: [id])

  @@index([productId, reason])
  @@index([locationId])
  @@index([batchId])
}

enum Role {
  USER
  ADMIN
  MANAGER
  POS_OPERATOR
  PACKING
  DELIVERY_PARTNER
  CENTER_HEAD
  STORE_ADMIN
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum WeightUnit {
  KG
  GM
  LTR
  ML
  PIECE
  PACKET
}

enum Channel {
  WEB
  POS
  WHATSAPP
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  FAILED
}

enum BannerPosition {
  HOME_TOP
  HOME_MIDDLE
  CATEGORY_TOP
}

enum InventoryLogType {
  SALE
  PURCHASE
  RETURN
  DAMAGE
  SPOILAGE
  ADJUSTMENT
  TRANSFER
}

enum InventoryLedgerReferenceType {
  ORDER
  REFUND
  MORTALITY
  ADJUSTMENT
}

enum CouponType {
  DISCOUNT           // Flat or Percentage discount on the cart
  ITEM_DISCOUNT      // Discount applied to a specific product (e.g., 50% off milk)
  SPECIAL_PRICE_ITEM // Get product X at special price Y (e.g., butter at ₹1)
  FREE_GIFT          // Get product X for free (e.g., BOGO, free coriander)
  CASHBACK           // Wallet cashback
}

enum UserGroupSegment {
  ALL
  FIRST_ORDER_BUYERS  // Targeted to first-time shoppers
  LOYAL_SHOPPERS      // Target monthly repeat buyers
  SENIOR_CITIZENS     // Target seniors
  STUDENTS            // Target student hostel groups
  CORPORATE_PANTRY    // Target corporate pantries
}

model ChatMessage {
  id             String   @id @default(uuid())
  senderId       String
  senderName     String?
  isAdmin        Boolean  @default(false)
  message        String
  orderId        String?
  hasAttachment  Boolean  @default(false)
  attachmentType String?  // "IMAGE" | "VIDEO"
  isRead         Boolean  @default(false)
  sessionEnded   Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([senderId])
  @@index([createdAt])
  @@index([isAdmin])
}

// Join Table for Dedicated Individual User Coupons
model CouponUserTarget {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model ApiKey {
  id            String    @id @default(uuid())
  key           String    @unique
  name          String
  role          Role      @default(STORE_ADMIN)
  locationId    String?
  isActive      Boolean   @default(true)
  isSuspended   Boolean   @default(false)
  suspendReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  location      Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  metrics       ApiMetric[]
  incidents     SecurityIncident[]

  @@index([key])
  @@index([locationId])
}

model ApiMetric {
  id            String   @id @default(uuid())
  apiKeyId      String?
  endpoint      String
  method        String
  status        Int
  responseTime  Int      // in milliseconds
  requestBytes  Int      @default(0)
  responseBytes Int      @default(0)
  timestamp     DateTime @default(now())
  ipAddress     String
  country       String?
  userAgent     String?
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([apiKeyId])
  @@index([endpoint])
}

model SecurityIncident {
  id             String            @id @default(uuid())
  title          String
  description    String?
  threatType     String            // e.g. "SQL_INJECTION", "DDOS", "MASS_HARVEST", "IMPOSSIBLE_TRAVEL"
  severity       IncidentSeverity  @default(P2)
  status         IncidentStatus    @default(OPEN)
  apiKeyId       String?
  detectionProof Json?             // Captures source headers, payload snippet, parameters
  sourceIp       String?
  userAgent      String?
  country        String?
  assignedToId   String?           // Engineer userId
  slaDeadline    DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resolvedAt     DateTime?
  rootCause      String?
  resolution     String?
  comments       IncidentComment[]
  apiKey         ApiKey?           @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  assignedTo     User?             @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model IncidentComment {
  id         String           @id @default(uuid())
  incidentId String
  authorId   String
  content    String
  createdAt  DateTime         @default(now())
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id])
}

enum IncidentSeverity {
  P0 // Critical - 15m SLA
  P1 // High - 1h SLA
  P2 // Medium - 4h SLA
  P3 // Low - 24h SLA
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

model PageContent {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}